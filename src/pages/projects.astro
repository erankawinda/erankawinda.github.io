---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { projects } from "../data/projects";
---
<BaseLayout
  title="Selected Work — Eran Gamage"
  description="Selected work by Eran Gamage in climate and energy forecasting, scientific data analysis, and retrieval evaluation."
>
  <SectionHeader
    eyebrow="Selected work"
    title="Projects and research threads"
    description="Selected projects showing how I work with scientific data, compare models, and explain what the evidence supports."
  />

  <section class="divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>

  <section class="max-w-3xl border-l border-[var(--border)] pl-5">
    <p class="leading-8 text-[var(--muted)]">
      Each repository explains the problem, method, available evidence, and limits. Team work is identified alongside my contribution.
    </p>
  </section>
</BaseLayout>
