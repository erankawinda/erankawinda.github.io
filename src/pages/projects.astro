---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { projects } from "../data/projects";
---
<BaseLayout
  title="Selected Work — Eran Gamage"
  description="Selected work by Eran Gamage across retrieval, machine-learning evaluation, energy data, and climate modelling."
>
  <SectionHeader
    eyebrow="Selected work"
    title="Projects and research threads"
    description="These are not meant to be a complete archive. They are selected pieces of work that show how I approach data, modelling, retrieval, and evaluation."
  />

  <section class="divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>

  <section class="max-w-3xl border-l border-[var(--border)] pl-5">
    <p class="leading-8 text-[var(--muted)]">
      This page is a selected record of projects with a documented problem, method, contribution boundary, and evaluation scope.
    </p>
  </section>
</BaseLayout>
