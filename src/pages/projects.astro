---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { projects, projectGroups } from "../data/projects";
---
<BaseLayout
  title="Work — Eran Gamage"
  description="Projects by Eran Gamage in language-model tuning, climate and energy forecasting, retrieval evaluation, data visualisation, and web applications."
>
  <section class="space-y-7">
    <SectionHeader
      eyebrow="Work"
      title="Projects and research"
      description="Research, applications, and coursework spanning language models, climate, energy, and data science."
    />
    <nav aria-label="Project categories" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
      {projectGroups.map((group) => <a class="link" href={`#${group.id}`}>{group.title}</a>)}
    </nav>
  </section>

  {projectGroups.map((group) => (
    <section id={group.id} class="project-group" aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`} class="mb-8 text-2xl font-semibold md:text-3xl">{group.title}</h2>
      <div class="divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]">
        {projects.filter((project) => project.group === group.id).map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  ))}
</BaseLayout>
