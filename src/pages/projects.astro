---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    area: "Retrieval augmented generation",
    title: "Investor Assistant RAG",
    summary: "A retrieval-based assistant for ASX company information, designed around grounded answers and transparent source use.",
    details: [
      "Worked with embeddings, retrieval pipelines, Streamlit interfaces, and evaluation metrics such as ROUGE, BERTScore, and NDCG.",
      "Focused on practical answer quality: relevance, traceability, and clear failure modes."
    ],
    tags: ["RAG", "NLP", "Evaluation", "Streamlit"],
    link: "https://github.com/rmit-ds-investor-assistant",
    linkLabel: "GitHub organisation"
  },
  {
    area: "Energy data",
    title: "GridAI — Australian grid analytics",
    summary: "Forecasting and analysis work using AEMO Dispatch SCADA and demand datasets from the National Electricity Market.",
    details: [
      "Explored reproducible modelling pipelines with time-aware validation.",
      "Used classical ML models such as random forests and XGBoost as practical forecasting baselines."
    ],
    tags: ["AEMO", "NEM", "Forecasting", "XGBoost"]
  },
  {
    area: "Privacy-preserving systems",
    title: "UBT / PIR private retrieval",
    summary: "Research notes and experiments around private queries, proof ideas, and retrieval structures for blockchain contexts.",
    details: [
      "Studied PIR-style access patterns, subtree structures, BLAKE3 hashing, and proof-of-innocence concepts.",
      "The goal is to understand the trade-off between privacy, verification cost, and usable protocol design."
    ],
    tags: ["PIR", "UBT", "Blockchain", "BLAKE3"]
  },
  {
    area: "Climate analytics",
    title: "Deep learning for drought prediction",
    summary: "A modelling project on long-term drought prediction for Sri Lanka using SPEI-style drought indicators.",
    details: [
      "Compared neural network approaches such as RNNs and ANNs for sequence-based drought signals.",
      "Connected a physics background with applied environmental data science."
    ],
    tags: ["Deep Learning", "Time Series", "SPEI", "Sri Lanka"]
  }
];
---
<BaseLayout
  title="Projects — Eran Gamage"
  description="Selected projects by Eran Gamage across RAG, energy analytics, privacy-preserving retrieval, and climate data science."
>
  <section class="max-w-3xl space-y-4">
    <p class="eyebrow">Selected work</p>
    <h1 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">Projects</h1>
    <p class="text-lg leading-8 text-slate-300">
      A small set of projects that reflect the areas I keep returning to: useful AI systems, careful evaluation, energy data, and privacy-aware protocols.
    </p>
  </section>

  <section class="mt-10 grid gap-6 md:grid-cols-2">
    {projects.map((project) => (
      <article class="card project-card">
        <div class="project-body">
          <p class="eyebrow">{project.area}</p>
          <h2 class="mt-4 text-2xl font-semibold tracking-tight text-white">{project.title}</h2>
          <p class="mt-3 leading-7 text-slate-300">{project.summary}</p>

          <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-300">
            {project.details.map((detail) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-300/80"></span>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {project.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>

        {project.link && (
          <a class="link mt-5 inline-flex text-sm font-medium" href={project.link} target="_blank" rel="noreferrer">
            {project.linkLabel}
          </a>
        )}
      </article>
    ))}
  </section>
</BaseLayout>
