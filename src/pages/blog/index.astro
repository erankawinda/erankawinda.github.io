---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Notes - Eran Gamage">
  <section class="max-w-3xl space-y-4">
    <p class="eyebrow">Notes</p>
    <h1 class="text-3xl font-semibold tracking-tight text-white md:text-4xl">Writing</h1>
    <p class="muted-copy">
      Short notes on the site, project decisions, and research topics I am working through.
    </p>
  </section>

  <section class="mt-10">
    <a class="card block" href="/blog/hello">
      <p class="eyebrow">Site note</p>
      <h2 class="mt-3 text-xl font-semibold">Why this site is small</h2>
      <p class="mt-2 muted-copy">A brief note on using Astro, Tailwind, and static pages for a personal portfolio.</p>
    </a>
  </section>
</BaseLayout>
