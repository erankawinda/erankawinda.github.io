---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const posts = [
  {
    href: "/blog/hello",
    title: "Why keep notes?",
    description: "A short note on writing things down while learning and building.",
    date: "May 2026"
  }
];
---
<BaseLayout
  title="Notes — Eran Gamage"
  description="Short notes from Eran Gamage on scientific machine learning, retrieval, evaluation, energy data, and research practice."
>
  <SectionHeader
    eyebrow="Notes"
    title="Short technical notes"
    description="This will be a place for compact writing on scientific machine learning, retrieval systems, evaluation, energy data, and lessons from research work."
  />

  <section class="space-y-4">
    {posts.map((post) => (
      <a class="card block" href={post.href}>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="text-xl font-semibold text-[var(--text)]">{post.title}</h2>
            <p class="mt-2 leading-7 text-[var(--muted)]">{post.description}</p>
          </div>
          <span class="tag shrink-0">{post.date}</span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
