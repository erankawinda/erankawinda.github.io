---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";
import TimelineItem from "../components/TimelineItem.astro";

const backgroundGroups = [
  {
    title: "Education",
    entries: [
      { date: "2024–2026", title: "Master of Data Science", description: "RMIT University — completed with Distinction." },
      { date: "2017–2021", title: "BSc Honours in Physics", description: "University of Colombo — physics, with foundations in mathematics and computer science." }
    ]
  },
  {
    title: "Research and teaching",
    entries: [
      { date: "2021–2022", title: "Teaching Assistant", description: "University of Colombo — supported physics teaching and laboratory coursework, including course materials and student assessment." },
      { date: "2021–2022", title: "CMS/GEM research exposure", description: "Attended technical briefings with the University of Colombo particle physics team." },
      { date: "2021", title: "Undergraduate drought research", description: "University of Colombo — studied recurrent neural networks for drought prediction in Sri Lanka." }
    ]
  },
  {
    title: "Scientific programmes",
    entries: [
      { date: "2021", title: "JENNIFER2 mentorship and summer school", description: "Implemented neural-network methods on FPGAs during the mentorship programme." },
      { date: "2018", title: "Asian Science Camp", description: "Represented Sri Lanka at the Asian Science Camp in Indonesia." }
    ]
  }
];

const interests = [
  "Scientific machine learning",
  "High-energy physics",
  "Climate modelling",
  "Time-series forecasting",
  "Energy analytics",
  "Retrieval-augmented generation",
  "NLP evaluation",
  "Data visualisation"
];
---
<BaseLayout
  title="About — Eran Gamage"
  description="About Eran Gamage, from physics training to data science, scientific machine learning, energy analytics, and climate modelling."
>
  <section class="max-w-3xl space-y-5">
    <p class="eyebrow">About</p>
    <h1 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-5xl">
      From physics to data systems.
    </h1>
    <p class="text-lg leading-8 text-[var(--muted)]">
      My background is in physics, where I learned to think carefully about measurement, assumptions, uncertainty, and models. That way of thinking still shapes how I approach data science.
    </p>
    <p class="leading-8 text-[var(--muted)]">
      I completed a Master of Data Science with Distinction at RMIT University. During the programme, I worked on machine learning, retrieval-augmented systems, time-series modelling, and evaluation.
    </p>
    <p class="leading-8 text-[var(--muted)]">
      I’m especially interested in scientific machine learning and particle physics, with a focus on problems where conclusions are supported by clear baselines, careful validation, and results that can be inspected.
    </p>
  </section>

  {backgroundGroups.map((group) => (
    <section>
      <h2 class="text-2xl font-semibold tracking-tight text-[var(--text)] md:text-3xl">{group.title}</h2>
      <div class="mt-6">
        {group.entries.map((item) => (
          <TimelineItem date={item.date} title={item.title} description={item.description} />
        ))}
      </div>
    </section>
  ))}

  <section>
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Interests</p>
      <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">Interests</h2>
    </div>
    <div class="mt-6">
      <TagList tags={interests} />
    </div>
  </section>
</BaseLayout>
