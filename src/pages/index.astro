---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const directions = [
  {
    title: "Particle physics and simulation",
    text: "I’m interested in how machine learning can make scientific simulations more efficient while preserving their accuracy."
  },
  {
    title: "Climate and energy forecasting",
    text: "My forecasting projects explore drought in Sri Lanka and electricity demand in Australia."
  },
  {
    title: "Efficient machine learning",
    text: "My master’s research explored adapting language models for structured text generation with limited GPU memory."
  }
];

const selectedWork = projects.filter((project) => project.featured);
---
<BaseLayout
  title="Eran Dodampe Gamage — Physics and Data Science"
  description="Eran Dodampe Gamage is a data scientist with a background in physics and interests in scientific machine learning, particle physics, climate, and energy systems."
>
  <section class="grid gap-14 lg:grid-cols-[1.28fr_0.72fr] lg:items-start">
    <div class="space-y-9">
      <p class="eyebrow">Physics · Data Science · Scientific ML</p>

      <div class="space-y-6">
        <h1 class="max-w-4xl text-4xl font-semibold tracking-tight text-[var(--text)] md:text-6xl">
          Data science shaped by a background in physics.
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-[var(--muted)]">
          I’m Eran Dodampe Gamage. I completed a Master of Data Science with Distinction at RMIT University, following an honours degree in physics at the University of Colombo. I’m working towards research that brings machine learning and physics together.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/projects">Explore my work</a>
        <a class="btn btn-ghost" href="/about">About me</a>
        <a class="btn btn-ghost" href="/cv/Eran-Dodampe-Gamage-CV.pdf">Academic CV (PDF)</a>
      </div>
    </div>

    <aside class="card subtle-card">
      <p class="eyebrow">Current directions</p>
      <ul class="mt-6 space-y-5 text-sm leading-6 text-[var(--muted)]">
        {directions.map((item) => (
          <li>
            <span class="font-medium text-[var(--text)]">{item.title}</span><br />
            {item.text}
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section>
    <div class="max-w-3xl space-y-4">
      <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">
        Selected work
      </h2>
      <p class="text-lg leading-8 text-[var(--muted)]">
        Projects in language-model adaptation, environmental forecasting, and retrieval systems.
      </p>
    </div>

    <div class="mt-8 divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]">
      {selectedWork.map((item) => (
        <article class="grid gap-3 py-6 md:grid-cols-[0.35fr_0.65fr]">
          <h3 class="text-xl font-semibold text-[var(--text)]"><a class="hover:text-[var(--accent)]" href={item.caseStudyHref ?? `/projects/#${item.id}`}>{item.title}</a></h3>
          <p class="leading-7 text-[var(--muted)]">{item.summary}</p>
        </article>
      ))}
    </div>
    <a class="link mt-6 inline-flex text-sm font-medium" href="/projects">Explore all projects</a>
  </section>

  <section class="max-w-3xl space-y-5">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">
      Teaching and student leadership
    </h2>
    <p class="text-lg leading-8 text-[var(--muted)]">
      At the University of Colombo, I supported physics laboratory classes and tutorials. As President of the Physics Society, I organised student discussions, guest lectures, and academic activities for physics undergraduates.
    </p>
    <p class="leading-8 text-[var(--muted)]">
      At RMIT, I represented Master of Data Science students on the Student–Staff Consultative Committee.
    </p>
    <a class="link inline-flex text-sm font-medium" href="/about">More about my background</a>
  </section>

  <section class="grid gap-5 border border-[var(--border-soft)] p-6 md:grid-cols-[0.7fr_0.3fr] md:items-center">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 class="mt-4 text-2xl font-semibold text-[var(--text)]">Research and collaboration</h2>
      <p class="mt-3 leading-7 text-[var(--muted)]">
        I welcome conversations about research opportunities and collaboration in scientific machine learning and data science.
      </p>
    </div>
    <a class="btn btn-primary md:justify-self-end" href="/contact">Get in touch</a>
  </section>
</BaseLayout>
