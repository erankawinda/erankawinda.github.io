---
import BaseLayout from "../layouts/BaseLayout.astro";

const directions = [
  {
    title: "Retrieval and evaluation",
    text: "RAG workflows, document search, answer grounding, and measurement beyond surface-level demos."
  },
  {
    title: "Energy and forecasting",
    text: "Analysis of grid and demand data, time-aware validation, and modelling choices that respect temporal structure."
  },
  {
    title: "Privacy-aware access",
    text: "Exploring PIR, UBT-style retrieval, and protocol ideas where access patterns and verification matter."
  }
];

const principles = [
  {
    title: "Start from the system",
    text: "I try to understand the data source, constraints, and failure modes before choosing a model."
  },
  {
    title: "Make evaluation visible",
    text: "For retrieval and forecasting work, I care about baselines, temporal splits, uncertainty, and readable evidence."
  },
  {
    title: "Keep the implementation legible",
    text: "Good technical work should be easy to inspect, reproduce, and explain to someone with a different background."
  }
];

const selectedWork = [
  {
    title: "Investor Assistant RAG",
    text: "Retrieval and evaluation workflows for company information and grounded answers."
  },
  {
    title: "GridAI",
    text: "Forecasting and analysis around Australian electricity market data."
  },
  {
    title: "Drought prediction",
    text: "Undergraduate research using deep learning methods for meteorological drought forecasting in Sri Lanka."
  },
  {
    title: "Private retrieval notes",
    text: "Exploration of privacy-aware query and retrieval ideas in blockchain contexts."
  }
];
---
<BaseLayout
  title="Eran Gamage — Research-minded Data Science"
  description="Eran Gamage is a physics-trained data science researcher and master's student working across retrieval systems, forecasting, energy analytics, and privacy-aware data access."
>
  <section class="grid gap-14 lg:grid-cols-[1.28fr_0.72fr] lg:items-start">
    <div class="space-y-9">
      <p class="eyebrow">Physics · Data Science · Applied AI</p>

      <div class="space-y-6">
        <h1 class="max-w-4xl text-4xl font-semibold tracking-tight text-[var(--text)] md:text-6xl">
          Research-minded data science for systems that need to be understood.
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-[var(--muted)]">
          I’m Eran Gamage, a physics-trained data science researcher and master’s student. My work sits between retrieval systems, forecasting, energy analytics, and privacy-aware data access — with an emphasis on methods that can be evaluated, explained, and improved.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/projects">View selected work</a>
        <a class="btn btn-ghost" href="/about">About me</a>
      </div>
    </div>

    <aside class="card subtle-card">
      <p class="eyebrow">Current directions</p>
      <ul class="mt-6 space-y-5 text-sm leading-6 text-[var(--muted)]">
        {directions.map((item) => (
          <li>
            <span class="font-medium text-[var(--text)]">{item.title}</span><br />
            {item.text}
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section>
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Working style</p>
      <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">
        How I approach technical work
      </h2>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {principles.map((principle) => (
        <article class="border-t border-[var(--border-soft)] py-5">
          <h3 class="text-xl font-semibold text-[var(--text)]">{principle.title}</h3>
          <p class="mt-3 leading-7 text-[var(--muted)]">{principle.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Selected work</p>
      <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">
        Selected work
      </h2>
      <p class="text-lg leading-8 text-[var(--muted)]">
        A few projects that connect my physics background with retrieval, forecasting, and evaluation.
      </p>
    </div>

    <div class="mt-8 divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]">
      {selectedWork.map((item) => (
        <article class="grid gap-3 py-6 md:grid-cols-[0.35fr_0.65fr]">
          <h3 class="text-xl font-semibold text-[var(--text)]">{item.title}</h3>
          <p class="leading-7 text-[var(--muted)]">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="grid gap-5 border border-[var(--border-soft)] p-6 md:grid-cols-[0.7fr_0.3fr] md:items-center">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 class="mt-4 text-2xl font-semibold text-[var(--text)]">Open to thoughtful technical conversations.</h2>
      <p class="mt-3 leading-7 text-[var(--muted)]">
        I’m interested in research, data science, applied AI, energy analytics, and privacy-aware information systems.
      </p>
    </div>
    <a class="btn btn-primary md:justify-self-end" href="/contact">Get in touch</a>
  </section>
</BaseLayout>
