---
import BaseLayout from "../layouts/BaseLayout.astro";

const directions = [
  {
    title: "Scientific machine learning",
    text: "Machine-learning methods for data-rich scientific problems, with particular interest in simulation and analysis in particle physics."
  },
  {
    title: "Climate and energy forecasting",
    text: "Clear data provenance, time-aware validation, and baseline comparisons for environmental and electricity-demand data."
  },
  {
    title: "Retrieval and evaluation",
    text: "RAG workflows, document search, answer grounding, and evaluation beyond surface-level demos."
  }
];

const principles = [
  {
    title: "Start from the system",
    text: "I try to understand the data source, constraints, and failure modes before choosing a model."
  },
  {
    title: "Make evaluation visible",
    text: "For retrieval and forecasting work, I care about baselines, temporal splits, uncertainty, and readable evidence."
  },
  {
    title: "Keep the implementation legible",
    text: "Good technical work should be easy to inspect, reproduce, and explain to someone with a different background."
  }
];

const selectedWork = [
  {
    title: "SPEI drought forecasting",
    text: "A reproducible one-month-ahead climate benchmark with baseline comparisons, uncertainty estimates, and documented historical-data limits."
  },
  {
    title: "Electricity demand forecasting",
    text: "A half-hour-ahead benchmark using measured Australian electricity demand, with chronological model comparisons and a reproducible historical pilot."
  },
  {
    title: "Investor Assistant RAG",
    text: "Authored the team repository’s retained evaluation package for answer quality and out-of-knowledge-base behaviour."
  }
];
---
<BaseLayout
  title="Eran Gamage — Physics and Data Science"
  description="Eran Gamage is a data scientist with a background in physics and interests in scientific machine learning, particle physics, climate, and energy systems."
>
  <section class="grid gap-14 lg:grid-cols-[1.28fr_0.72fr] lg:items-start">
    <div class="space-y-9">
      <p class="eyebrow">Physics · Data Science · Scientific ML</p>

      <div class="space-y-6">
        <h1 class="max-w-4xl text-4xl font-semibold tracking-tight text-[var(--text)] md:text-6xl">
          Data science shaped by a background in physics.
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-[var(--muted)]">
          I’m Eran Gamage, a data scientist with a background in physics. I completed a Master of Data Science with Distinction at RMIT University. I’m interested in scientific machine learning and in methods that can be tested, explained, and improved.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/projects">View selected work</a>
        <a class="btn btn-ghost" href="/about">About me</a>
      </div>
    </div>

    <aside class="card subtle-card">
      <p class="eyebrow">Current directions</p>
      <ul class="mt-6 space-y-5 text-sm leading-6 text-[var(--muted)]">
        {directions.map((item) => (
          <li>
            <span class="font-medium text-[var(--text)]">{item.title}</span><br />
            {item.text}
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section>
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Working style</p>
      <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">
        How I approach technical work
      </h2>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {principles.map((principle) => (
        <article class="border-t border-[var(--border-soft)] py-5">
          <h3 class="text-xl font-semibold text-[var(--text)]">{principle.title}</h3>
          <p class="mt-3 leading-7 text-[var(--muted)]">{principle.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Selected work</p>
      <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-4xl">
        Selected work
      </h2>
      <p class="text-lg leading-8 text-[var(--muted)]">
        Selected work in climate and energy forecasting, scientific data analysis, and retrieval evaluation.
      </p>
    </div>

    <div class="mt-8 divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]">
      {selectedWork.map((item) => (
        <article class="grid gap-3 py-6 md:grid-cols-[0.35fr_0.65fr]">
          <h3 class="text-xl font-semibold text-[var(--text)]">{item.title}</h3>
          <p class="leading-7 text-[var(--muted)]">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="grid gap-5 border border-[var(--border-soft)] p-6 md:grid-cols-[0.7fr_0.3fr] md:items-center">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 class="mt-4 text-2xl font-semibold text-[var(--text)]">Open to thoughtful technical conversations.</h2>
      <p class="mt-3 leading-7 text-[var(--muted)]">
        I’m interested in scientific machine learning, particle physics, data science, and careful model evaluation.
      </p>
    </div>
    <a class="btn btn-primary md:justify-self-end" href="/contact">Get in touch</a>
  </section>
</BaseLayout>
