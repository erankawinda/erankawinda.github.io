---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact — Eran Dodampe Gamage"
  description="Contact Eran Dodampe Gamage about scientific machine learning, data science, particle physics, climate, and energy systems."
>
  <section class="max-w-3xl space-y-5">
    <p class="eyebrow">Contact</p>
    <h1 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-5xl">Contact</h1>
    <p class="text-lg leading-8 text-[var(--muted)]">
      I’m happy to hear from people working on scientific machine learning, data science, particle physics, climate, or energy systems.
    </p>
  </section>

  <section class="grid gap-5 md:grid-cols-3">
    <a class="card" href="mailto:erangamage@gmail.com">
      <p class="eyebrow">Email</p>
      <h2 class="mt-4 text-lg font-semibold text-[var(--text)]">erangamage@gmail.com</h2>
      <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
        For research enquiries and collaboration.
      </p>
    </a>

    <a class="card" href="https://www.linkedin.com/in/eran-gamage/" target="_blank" rel="noreferrer">
      <p class="eyebrow">LinkedIn</p>
      <h2 class="mt-4 text-lg font-semibold text-[var(--text)]">Professional background</h2>
      <p class="mt-3 text-sm leading-6 text-[var(--muted)]">Education, experience, and professional updates.</p>
    </a>

    <a class="card" href="https://github.com/erankawinda" target="_blank" rel="noreferrer">
      <p class="eyebrow">GitHub</p>
      <h2 class="mt-4 text-lg font-semibold text-[var(--text)]">Repositories and experiments</h2>
      <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
        Project code, documentation, and reproducible experiments.
      </p>
    </a>
  </section>

</BaseLayout>
