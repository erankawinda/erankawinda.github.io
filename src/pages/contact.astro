---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact — Eran Gamage"
  description="Contact Eran Gamage for research, data science, AI systems, and collaboration conversations."
>
  <section class="max-w-3xl space-y-5">
    <p class="eyebrow">Contact</p>
    <h1 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">Get in touch</h1>
    <p class="text-lg leading-8 text-slate-300">
      I’m open to thoughtful conversations about research, data science projects, AI systems, and technical collaboration.
    </p>
  </section>

  <section class="mt-10 grid gap-5 md:grid-cols-3">
    <a class="card" href="mailto:erangamage@gmail.com">
      <p class="eyebrow">Email</p>
      <h2 class="mt-4 text-lg font-semibold text-white">erangamage@gmail.com</h2>
      <p class="mt-3 text-sm leading-6 text-slate-300">Best for direct messages and collaboration notes.</p>
    </a>

    <a class="card" href="https://linkedin.com/in/eran-gamage" target="_blank" rel="noreferrer">
      <p class="eyebrow">LinkedIn</p>
      <h2 class="mt-4 text-lg font-semibold text-white">Professional profile</h2>
      <p class="mt-3 text-sm leading-6 text-slate-300">For background, updates, and professional context.</p>
    </a>

    <a class="card" href="https://github.com/erankawinda" target="_blank" rel="noreferrer">
      <p class="eyebrow">GitHub</p>
      <h2 class="mt-4 text-lg font-semibold text-white">Code and projects</h2>
      <p class="mt-3 text-sm leading-6 text-slate-300">For repositories, experiments, and implementation work.</p>
    </a>
  </section>
</BaseLayout>
