---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact - Eran Gamage">
  <section class="max-w-3xl space-y-4">
    <p class="eyebrow">Contact</p>
    <h1 class="text-3xl font-semibold tracking-tight text-white md:text-4xl">Get in touch</h1>
    <p class="muted-copy">
      I am open to research conversations, project collaboration, and data science roles connected to applied AI, evaluation, energy analytics, or climate modelling.
    </p>
  </section>

  <section class="mt-10 grid gap-4 md:grid-cols-3">
    <a class="card" href="mailto:erangamage@gmail.com">
      <p class="eyebrow">Email</p>
      <p class="mt-3 break-words text-sm text-slate-200">erangamage@gmail.com</p>
    </a>
    <a class="card" target="_blank" rel="noreferrer" href="https://linkedin.com/in/eran-gamage">
      <p class="eyebrow">LinkedIn</p>
      <p class="mt-3 break-words text-sm text-slate-200">linkedin.com/in/eran-gamage</p>
    </a>
    <a class="card" target="_blank" rel="noreferrer" href="https://github.com/erandg">
      <p class="eyebrow">GitHub</p>
      <p class="mt-3 break-words text-sm text-slate-200">github.com/erandg</p>
    </a>
  </section>
</BaseLayout>
