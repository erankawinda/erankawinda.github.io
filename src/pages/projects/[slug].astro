---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import { projects } from "../../data/projects";
import { projectStories } from "../../data/projectStories";

export function getStaticPaths() {
  return projectStories.map((story) => {
    const project = projects.find((entry) => entry.id === story.projectId);
    if (!project) throw new Error(`Missing project for story: ${story.projectId}`);
    return { params: { slug: project.id }, props: { project, story } };
  });
}

const { project, story } = Astro.props;
const projectLinks = project.links.filter((link) => link.href !== project.caseStudyHref);
---

<BaseLayout title={`${project.title} — Eran Dodampe Gamage`} description={project.summary}>
  <article class="space-y-12 md:space-y-16">
    <header class="max-w-3xl space-y-6">
      <a href={`/projects/#${project.id}`} class="link text-sm">All work</a>
      <p class="eyebrow">{project.category}</p>
      <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">{project.title}</h1>
      <p class="text-lg leading-8 text-[var(--muted)]">{project.summary}</p>
      <p class="text-sm text-[var(--subtle)]">{project.status}</p>
      <TagList tags={project.tags} />
    </header>

    {story.sections.map((section, index) => (
      <section aria-labelledby={`story-section-${index}`} class="space-y-5 border-t border-[var(--border-soft)] pt-8">
        <h2 id={`story-section-${index}`} class="scroll-mt-36 text-2xl font-semibold md:text-3xl">{section.title}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class="max-w-3xl leading-8 text-[var(--muted)]">{paragraph}</p>
        ))}
        {section.table && (
          <div class="max-w-3xl overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm leading-6">
              <caption class="pb-4 text-left text-[var(--muted)]">{section.table.caption}</caption>
              <thead>
                <tr class="border-y border-[var(--border)]">
                  {section.table.headers.map((header) => <th scope="col" class="px-3 py-3 font-medium first:pl-0">{header}</th>)}
                </tr>
              </thead>
              <tbody>
                {section.table.rows.map((row) => (
                  <tr class="border-b border-[var(--border-soft)] text-[var(--muted)]">
                    {row.map((cell, cellIndex) => cellIndex === 0
                      ? <th scope="row" class="py-3 pr-3 font-normal text-[var(--text)]">{cell}</th>
                      : <td class="px-3 py-3 tabular-nums">{cell}</td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {section.figure && (
          <figure class="space-y-4 pt-4">
            <a href={section.figure.src} aria-label="Open the forecast chart at full size" class="block">
              <img
                src={section.figure.src}
                alt={section.figure.alt}
                width={section.figure.width}
                height={section.figure.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full border border-[var(--border)]"
              />
            </a>
            <figcaption class="max-w-3xl text-sm leading-6 text-[var(--muted)]">{section.figure.caption}</figcaption>
          </figure>
        )}
      </section>
    ))}

    <footer class="flex flex-wrap gap-x-6 gap-y-4 border-t border-[var(--border-soft)] pt-8 text-sm">
      {story.evidenceLink && (
        <a class="link" href={story.evidenceLink.href} target="_blank" rel="noreferrer">{story.evidenceLink.label}</a>
      )}
      {story.sourceLink && (
        <a class="link" href={story.sourceLink.href} target="_blank" rel="noreferrer">{story.sourceLink.label}</a>
      )}
      {projectLinks.map((link) => (
        <a class="link" href={link.href} target={link.href.startsWith("https://") ? "_blank" : undefined} rel={link.href.startsWith("https://") ? "noreferrer" : undefined}>{link.label}</a>
      ))}
      <a class="link" href="/projects/">All work</a>
    </footer>
  </article>
</BaseLayout>
