---
const {
  title = "Eran Gamage - Data Science Portfolio",
  description = "Research-oriented portfolio for Eran Gamage, focused on practical AI, evaluation, energy analytics, and privacy-preserving retrieval."
} = Astro.props;
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-900/60 backdrop-blur">
      <div class="container-nice flex min-h-14 flex-wrap items-center justify-between gap-3 py-3">
        <a href="/" class="font-semibold tracking-tight">Eran</a>
        <nav class="flex items-center gap-4 text-sm text-slate-300 sm:gap-6" aria-label="Primary navigation">
          <a href="/projects" class="hover:text-white">Projects</a>
          <a href="/blog" class="hover:text-white">Blog</a>
          <a href="/about" class="hover:text-white">About</a>
          <a href="/contact" class="hover:text-white">Contact</a>
        </nav>
      </div>
    </header>

    <main class="container-nice py-14">
      <slot />
    </main>

    <footer class="container-nice py-10 text-sm text-slate-400">
      © {new Date().getFullYear()} Eran Dodampe Gamage · Built with Astro + Tailwind
    </footer>
  </body>
</html>
