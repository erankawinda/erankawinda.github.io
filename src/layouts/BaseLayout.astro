---
import "../styles/global.css";

const frontmatter = Astro.props.frontmatter ?? {};

const {
  title = frontmatter.title ?? "Eran Gamage — Physics & Data Science",
  description = frontmatter.description ?? "Portfolio of Eran Gamage, a data scientist with a background in physics and interests in scientific machine learning."
} = Astro.props;

const navItems = [
  { href: "/projects", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" }
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(href));
const canonicalURL = new URL(pathname === "/" ? "/" : `${pathname}/`, Astro.site);
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080d16" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eran Gamage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-5 focus:top-3 focus:z-[100] focus:bg-[var(--bg)] focus:px-4 focus:py-2" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="container-nice flex min-h-16 items-center justify-between gap-4 py-3">
          <a href="/" class="brand" aria-label="Eran Gamage home">
            <span class="brand-mark mono">EG</span>
            <span>Eran Gamage</span>
          </a>

          <nav class="flex flex-wrap items-center justify-end gap-1" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={["nav-link", isActive(item.href) && "nav-link-active"]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main id="main-content" class="container-nice content-area py-14 md:py-20">
        <slot />
      </main>

      <footer class="container-nice site-footer py-8 text-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} Eran Gamage</p>
          <div class="flex flex-wrap gap-x-4 gap-y-2">
            <a class="footer-link" href="mailto:erangamage@gmail.com">Email</a>
            <a class="footer-link" href="https://github.com/erankawinda" target="_blank" rel="noreferrer">GitHub</a>
            <a class="footer-link" href="https://www.linkedin.com/in/eran-gamage/" target="_blank" rel="noreferrer">LinkedIn</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
