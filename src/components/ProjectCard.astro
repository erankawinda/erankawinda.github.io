---
import TagList from "./TagList.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article id={project.id} class="project-entry" aria-labelledby={`${project.id}-title`}>
  <div class="project-entry-meta">
    <p class="eyebrow">{project.category}</p>
    <p class="mt-3 text-sm leading-6 text-[var(--subtle)]">{project.status}</p>
  </div>

  <div class="project-entry-body">
    <h3 id={`${project.id}-title`} class="text-2xl font-semibold tracking-tight text-[var(--text)]">{project.title}</h3>
    <p class="mt-3 max-w-3xl leading-7 text-[var(--muted)]">{project.summary}</p>

    <ul class="mt-5 space-y-3 text-sm leading-6 text-[var(--muted)]">
      {project.details.map((detail) => (
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]"></span>
          <span>{detail}</span>
        </li>
      ))}
    </ul>

    <div class="mt-6">
      <TagList tags={project.tags} />
    </div>

    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
      {project.links.map((link) => (
        <a
          class="link inline-flex text-sm font-medium"
          href={link.href}
          target={link.href.startsWith("https://") ? "_blank" : undefined}
          rel={link.href.startsWith("https://") ? "noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</article>
