---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="max-w-3xl space-y-4">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="text-3xl font-semibold tracking-tight text-[var(--text)] md:text-5xl">{title}</h1>
  {description && <p class="text-lg leading-8 text-[var(--muted)]">{description}</p>}
</section>
